{
  "name": "ganrich-advisory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --max-old-space-size=4096 --experimental-strip-types --test tests/rendered-html.test.mjs tests/editor-auth.test.mjs tests/inquiry-notify.test.mjs tests/traffic.test.mjs tests/newsletter.test.mjs tests/check-result.test.mjs tests/edge-cache.test.mjs tests/gone.test.mjs tests/root-lang.test.mjs tests/deploy-target.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "release:preflight": "node scripts/release-preflight.mjs",
    "og:generate": "node scripts/generate-og-cards.mjs",
    "content:freshness": "node --experimental-strip-types scripts/content-freshness.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "deploy:preview": "scripts/deploy.sh preview"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.8",
    "wrangler": "4.165.0"
  },
  "type": "module"
}
