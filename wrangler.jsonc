// Cloudflare Workers configuration for Ganrich Advisory.
//
// The top level is the local development and test setup (placeholder D1 id,
// local R2), matching what the Sites starter simulated. Real deployments pick
// a named environment at build time:
//
//   CLOUDFLARE_ENV=preview npm run build && npx wrangler deploy
//
// scripts/deploy.sh wraps those steps. Resource ids here are identifiers, not
// secrets; secrets go in `wrangler secret put` (see .env.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ganrich-advisory",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "site-creator-r2" }],
  "env": {
    // Temporary review address on workers.dev. Its own D1/R2, never production data.
    "preview": {
      "name": "ganrich-preview",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ganrich-preview-db",
          "database_id": "0503dacb-b558-441f-ad6f-c3510b90efe5",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "ganrich-preview-docs" }],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://ganrichadvisory.com",
        "EDITOR_AUTH": "access",
        "ACCESS_TEAM_DOMAIN": "fse2-planlar-pages.cloudflareaccess.com",
        "ACCESS_AUD": "840cfd2fcb52516c672d59877b897282a0ad21f4cf0b1b5f48c2540e9d47516d",
        "EDITOR_EMAILS": "furkangul@ganrichadvisory.com,ahmedfurkangul@gmail.com",
        "INQUIRY_NOTIFY_TO": "furkangul@ganrichadvisory.com,ahmedfurkangul@gmail.com",
        "INQUIRY_NOTIFY_FROM": "Ganrich Advisory <notifications@ganrichadvisory.com>"
      }
    },
    // ganrichadvisory.com. The custom domains are attached in Cloudflare
    // (Workers > Settings > Domains) during the cutover in GODADDY-DNS.md, so
    // no routes are declared here. ACCESS_AUD stays empty, which keeps PDF
    // editing closed, until the Access app for the studio paths exists.
    "production": {
      "name": "ganrich-advisory",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ganrich-prod-db",
          "database_id": "b63868c9-0c0c-4251-a3cb-7ea3ad4e5d81",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "ganrich-prod-docs" }],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://ganrichadvisory.com",
        "EDITOR_AUTH": "access",
        "ACCESS_TEAM_DOMAIN": "fse2-planlar-pages.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "EDITOR_EMAILS": "furkangul@ganrichadvisory.com,ahmedfurkangul@gmail.com",
        "INQUIRY_NOTIFY_TO": "furkangul@ganrichadvisory.com,ahmedfurkangul@gmail.com",
        "INQUIRY_NOTIFY_FROM": "Ganrich Advisory <notifications@ganrichadvisory.com>"
      }
    }
  }
}
