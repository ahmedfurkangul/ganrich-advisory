# Cloudflare Workers static assets: cache rules for unhashed public files.
# Hashed bundles live under /_next/static/ (vinext 1.x); their names change with their content.
# Rename a file when its content changes, since browsers may keep it this long.
/brand/*
  Cache-Control: public, max-age=2592000
/people/*
  Cache-Control: public, max-age=2592000
/studio/*
  Cache-Control: public, max-age=604800
/og/*
  Cache-Control: public, max-age=86400
/favicon.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/newsletter/*
  Cache-Control: public, max-age=2592000
/reports/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
