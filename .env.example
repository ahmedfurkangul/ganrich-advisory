# Names only. Never commit real values. Local dev copies this to .env.local.
# Deployed values live in wrangler.jsonc "vars" (non-secret) or
# `npx wrangler secret put NAME --env <preview|production>` (secret).

# Public origin used for canonical URLs, sitemap, RSS and social cards.
NEXT_PUBLIC_SITE_URL=https://ganrichadvisory.com
# off | on — first-party analytics.
NEXT_PUBLIC_ANALYTICS_MODE=off
# Optional analytics forwarding endpoint and its token (secret).
ANALYTICS_ENDPOINT=
ANALYTICS_TOKEN=

# Editor identity for the PDF studio: access | sites | (empty = editing closed).
EDITOR_AUTH=
# Cloudflare Access team domain, e.g. <team>.cloudflareaccess.com.
ACCESS_TEAM_DOMAIN=
# Audience (AUD) tag of the Access application that protects the site or studio.
ACCESS_AUD=
# Comma-separated emails allowed to edit.
EDITOR_EMAILS=
# Optional shared key for scripted PDF batch ingestion (secret).
PDF_INGEST_KEY=

# Contact-form email alerts through Resend. Without all three, nothing is sent.
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=
INQUIRY_NOTIFY_FROM=
